{
    "name": "yiisoft/yii-auth-client",
    "description": "Yii Framework external authentication via OAuth",
    "keywords": [
        "yii",
        "OAuth",
        "auth",
        "api"
    ],
    "type": "library",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/yii-auth-client/issues?state=open",
        "source": "https://github.com/yiisoft/yii-auth-client",
        "forum": "https://www.yiiframework.com/forum/",
        "wiki": "https://www.yiiframework.com/wiki/",
        "irc": "ircs://irc.libera.chat:6697/yii",
        "chat": "https://t.me/yii3en"
    },
    "funding": [
        {
            "type": "opencollective",
            "url": "https://opencollective.com/yiisoft"
        },
        {
            "type": "github",
            "url": "https://github.com/sponsors/yiisoft"
        }
    ],
    "require": {
        "php": "8.4 - 8.5",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "phpseclib/phpseclib": ">=3.0.55",
        "psr/container": ">=2.0.2",
        "psr/http-client": ">=1.0.3",
        "psr/http-factory": ">=1.1",
        "psr/http-factory-implementation": "*",
        "psr/http-message": ">=2",
        "psr/http-message-implementation": "*",
        "psr/http-server-handler": ">=1.0.2",
        "psr/http-server-middleware": ">=1.0.2",
        "psr/log-implementation": "*",
        "psr/simple-cache": ">=3",
        "psr/simple-cache-implementation": "*",
        "web-token/jwt-framework": ">=4.1.7",
        "yiisoft/aliases": ">=3.1.1",
        "yiisoft/assets": ">=5.1.2",
        "yiisoft/factory": ">=1.3.1",
        "yiisoft/html": ">=4.2",
        "yiisoft/http": ">=1.3",
        "yiisoft/json": ">=1.1",
        "yiisoft/router": ">=4.0.2",
        "yiisoft/security": ">=1.2",
        "yiisoft/session": ">=3.0.1",
        "yiisoft/translator": ">=3.2.1",
        "yiisoft/view": ">=12.2.4",
        "yiisoft/widget": ">=2.2.2"
    },
    "require-dev": {
        "ext-curl": "*",
        "maglnet/composer-require-checker": ">=4.24",
        "kriswallsmith/buzz": ">=1.4",
        "nyholm/psr7": ">=1.8.2",
        "phpunit/phpunit": ">=12.5.24",        
        "rector/rector": ">=2.5.4",
        "roave/infection-static-analysis-plugin": ">=1.44",
        "spatie/phpunit-watcher": ">=1.24.4",
        "styleci/cli": ">=1.6",
        "vimeo/psalm": ">=6.16.1",
        "yiisoft/cache": ">=3.2",
        "yiisoft/di": ">=1.4.1",
        "yiisoft/log": ">=2.2.1",
        "yiisoft/router-fastroute": ">=4.0.3",
        "yiisoft/psr-dummy-provider": ">=1.0.2"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "Yiisoft\\Yii\\AuthClient\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yiisoft\\Yii\\AuthClient\\Tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        },
        "config-plugin-options": {
            "source-directory": "config"
        },
        "config-plugin": {
            "di": "di.php",
            "params": "params.php"
        }
    },
    "config": {
        "sort-packages": true,
        "bump-after-update": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "composer/package-versions-deprecated": true
        }
    },
    "scripts": {
        "test": "phpunit --stop-on-notice --display-phpunit-deprecations --testdox",
        "test-watch": "phpunit-watcher watch"
    }
}
